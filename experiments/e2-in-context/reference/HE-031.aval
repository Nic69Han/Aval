```aval
module solution

fn has_divisor(n: Int, d: Int) -> Bool
{
  return if d * d > n {
    false
  } else if n % d == 0 {
    true
  } else {
    has_divisor(n, d + 1)
  }
}

pub fn is_prime(n: Int) -> Bool
  examples
    7 => true
    8 => false
    1 => false
  cost O(n)
{
  return n >= 2 and not has_divisor(n, 2)
}
```
