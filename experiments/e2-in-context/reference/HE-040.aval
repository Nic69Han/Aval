```aval
module solution

pub fn triples_sum_to_zero(numbers: List<Int>) -> Bool
  examples
    [1, 3, -2, 1] => true
    [1, 2, 3, 7] => false
  cost O(numbers.len() * numbers.len() * numbers.len())
{
  let idx: List<Int> = for p in 0..numbers.len() { p }
  return idx.any(|i| idx.any(|j| idx.any(|k| i < j and j < k and numbers[i] + numbers[j] + numbers[k] == 0)))
}
```
