```aval
module solution

pub fn modp(n: Int, p: Int) -> Int
  requires n >= 0 and n < 2000 and p > 1 and p < 1000
  ensures result >= 0 and result < p
  examples
    3, 5 => 3
    0, 101 => 1
  cost O(n)
{
  let steps: List<Int> = for i in 0..n { i }
  return steps.fold(1, |acc, i| acc * 2 % p)
}
```
