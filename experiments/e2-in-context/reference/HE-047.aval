```aval
module solution

pub fn median(numbers: List<Int>) -> Float
  requires numbers.len() > 0
  examples
    [3, 1, 2, 4, 5] => 3.0
    [6, 5] => 5.5
  cost O(numbers.len() * log(numbers.len()))
{
  let s: List<Int> = numbers.sort()
  let n: Int = s.len()
  return if n % 2 == 1 { s[n / 2].float() } else { (s[n / 2 - 1] + s[n / 2]).float() / 2.0 }
}
```
