```aval
module solution

pub fn pairs_sum_to_zero(numbers: List<Int>) -> Bool
  examples
    [1, 3, -1] => true
    [1, 3, 4] => false
  cost O(numbers.len() * numbers.len())
{
  let found: List<Bool> = for i in 0..numbers.len() { numbers.skip(i + 1).contains(0 - numbers[i]) }
  return found.any(|b| b)
}
```
