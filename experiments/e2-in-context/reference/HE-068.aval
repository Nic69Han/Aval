```aval
module solution

pub fn pluck(arr: List<Int>) -> List<Int>
  ensures result.len() == 0 or result.len() == 2
  examples
    [4, 2, 3] => [2, 1]
    [1, 3] => []
  cost O(arr.len() * arr.len())
{
  let evens: List<Int> = arr.filter(|x| x % 2 == 0)
  let idx: List<Int> = for p in 0..arr.len() { p }
  return if evens.is_empty() {
    []
  } else {
    let smallest: Int = evens.min()
    let firsts: List<Int> = idx.filter(|i| arr[i] == smallest)
    [smallest, firsts[0]]
  }
}
```
